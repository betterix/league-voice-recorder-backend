# Server Configuration
DOMAIN_NAME=domain-name-here
PORT=8443
ENVIRONMENT=production

# Storage
STORAGE_DIR=/app/data/recordings
DB_DIR=/app/data/db

# Authentication: uv run python -m app.security
UPLOAD_KEY=generate-secure-random-upload-secret
PULL_KEY=generate-secure-random-pull-secret
ADMIN_KEY=generate-secure-random-admin-secret

# TLS Certificates
SSL_CERT=/app/certs/cert.pem
SSL_KEY=/app/certs/key.pem

# Upload Limits
MAX_UPLOAD_MB=250

# Rate Limiting & Brute-Force Protection
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=10
AUTH_FAILURE_LIMIT_PER_MINUTE=5
AUTH_BLOCK_DURATION_MINUTES=10

# Vulnerability Scanner & Exploit Probe Protection
SCANNER_BLOCK_ENABLED=true
SCANNER_BLOCK_DURATION_MINUTES=60
SCANNER_FAILURE_THRESHOLD=5
SCANNER_FAILURE_WINDOW_SECONDS=60.0

# Web Dashboard Configuration
WEB_ENABLED=true
# Restrict /web to your specific public IP, or set 0.0.0.0 for unrestricted access (less secure)
# Localhost (127.0.0.1) is always allowed by default for testing
WEB_ALLOWED_IPS=203.0.113.50
WEB_USERNAME=admin
WEB_PASSWORD=generate-secure-random-web-password
